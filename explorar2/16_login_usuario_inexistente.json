{
 "url": "https://www.maderasmym.cl/login",
 "titulo": "Maderas M&M - Login",
 "form": "<form id=\"login-form\" novalidate=\"\">\n        <div class=\"field\">\n          <label for=\"user\">Usuario o correo</label>\n          <input type=\"text\" name=\"user\" id=\"user\" placeholder=\"Tu nombre de usuario o correo\" required=\"\" autocomplete=\"username\">\n        </div>\n\n        <div class=\"field\">\n          <label for=\"password\">Contraseña</label>\n          <input type=\"password\" name=\"password\" id=\"password\" placeholder=\"Tu contraseña\" required=\"\" autocomplete=\"current-password\">\n          <p class=\"forgot-link\"><a id=\"forgot-link\" href=\"/forgot-password\">¿Olvidaste tu contraseña?</a></p>\n        </div>\n\n        <button type=\"submit\">Iniciar sesión</button>\n      </form>",
 "body": "<body>\n  <main>\n    <div class=\"form-container\">\n      <a href=\"/\" class=\"auth-logo-link\" aria-label=\"Volver al inicio\">\n        <img src=\"assets/mymlog.png\" alt=\"Maderas MyM\" class=\"auth-logo\">\n      </a>\n      <h1>Iniciar sesión</h1>\n      <p>¡Ingresa a tu cuenta!</p>\n\n      <form id=\"login-form\" novalidate=\"\">\n        <div class=\"field\">\n          <label for=\"user\">Usuario o correo</label>\n          <input type=\"text\" name=\"user\" id=\"user\" placeholder=\"Tu nombre de usuario o correo\" required=\"\" autocomplete=\"username\">\n        </div>\n\n        <div class=\"field\">\n          <label for=\"password\">Contraseña</label>\n          <input type=\"password\" name=\"password\" id=\"password\" placeholder=\"Tu contraseña\" required=\"\" autocomplete=\"current-password\">\n          <p class=\"forgot-link\"><a id=\"forgot-link\" href=\"/forgot-password\">¿Olvidaste tu contraseña?</a></p>\n        </div>\n\n        <button type=\"submit\">Iniciar sesión</button>\n      </form>\n\n      <!-- Login con Google. El backend (/auth/google) siempre existió; el botón\n           se había borrado de este archivo sin querer, por eso \"quedó\n           desconectado\". -->\n      <div class=\"auth-sep\"><span>o</span></div>\n      <a class=\"btn-google\" href=\"/auth/google\">\n        <svg viewBox=\"0 0 48 48\" width=\"18\" height=\"18\" aria-hidden=\"true\" focusable=\"false\">\n          <path fill=\"#EA4335\" d=\"M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z\"></path>\n          <path fill=\"#4285F4\" d=\"M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z\"></path>\n          <path fill=\"#FBBC05\" d=\"M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z\"></path>\n          <path fill=\"#34A853\" d=\"M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z\"></path>\n        </svg>\n        <span>Continuar con Google</span>\n      </a>\n\n      <!-- cuadro de mensaje -->\n      <p id=\"msg\" class=\"error\">Credenciales inválidas</p>\n      <div id=\"actions\" class=\"inline-actions escondido\">\n        <button id=\"btn-resend\" class=\"linklike\" type=\"button\">Reenviar verificación</button>\n      </div>\n\n      <p>¿Todavía no tienes una cuenta? <a href=\"/register\">Regístrate</a></p>\n    </div>\n\n    <p class=\"back-link\"><a href=\"/\">← Volver a la tienda</a></p>\n  </main>\n\n  <script>\n    const form = document.getElementById('login-form');\n    const msg  = document.getElementById('msg');\n    const actions = document.getElementById('actions');\n    const btnResend = document.getElementById('btn-resend');\n    const forgotLink = document.getElementById('forgot-link');\n\n    function showMsg(text, kind='error') {\n      msg.textContent = text;\n      msg.className = ''; // limpia\n      msg.classList.add(kind === 'ok' ? 'ok' : 'error');\n    }\n    function hideMsg() {\n      msg.textContent = '';\n      msg.className = 'escondido';\n    }\n    function showResend(show) {\n      actions.className = show ? 'inline-actions' : 'inline-actions escondido';\n    }\n\n    const submitBtn = form.querySelector('button[type=\"submit\"]');\n\n    // Avisos que llegan por querystring (?verified=1 tras verificar, ?reset=1 tras cambiar la clave)\n    const qs = new URLSearchParams(location.search);\n    if (qs.get('reset') === '1') {\n      showMsg('Contraseña actualizada. Ya puedes iniciar sesión.', 'ok');\n    } else if (qs.get('verified') === '1') {\n      showMsg('Correo verificado. Ya puedes iniciar sesión.', 'ok');\n    } else if (qs.get('google') === 'error') {\n      showMsg('No se pudo iniciar sesión con Google. Usa tu usuario y contraseña o inténtalo de nuevo.');\n    }\n\n    // Arrastra lo que ya escribió el usuario al formulario de recuperación.\n    forgotLink.addEventListener('click', () => {\n      const u = form.user.value.trim();\n      forgotLink.href = u ? `/forgot-password?u=${encodeURIComponent(u)}` : '/forgot-password';\n    });\n\n    form.addEventListener('submit', async (e) => {\n      e.preventDefault();\n      hideMsg();\n      showResend(false);\n\n      const user = form.user.value.trim();\n      const password = form.password.value;\n\n      if (!user || !password) {\n        showMsg('Completa usuario y contraseña');\n        return;\n      }\n\n      submitBtn.disabled = true;\n      submitBtn.textContent = 'Ingresando...';\n\n      try {\n        const res = await fetch('/api/login', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ user, password })\n        });\n\n        const data = await res.json().catch(() => ({}));\n\n        if (!res.ok) {\n          // Caso especial: no verificado\n          if (res.status === 403 && data.code === 'EMAIL_NOT_VERIFIED') {\n            showMsg('Tu cuenta no está verificada. Revisa tu correo o reenvía el enlace.', 'error');\n            showResend(true);\n            return;\n          }\n          // Otros errores (credenciales, etc.)\n          showMsg(data.message || 'Error al iniciar sesión');\n          return;\n        }\n\n        // OK → redirigir\n        showMsg('Login correcto. Redirigiendo...', 'ok');\n        if (data.redirect) {\n          location.href = data.redirect;\n        } else {\n          location.reload();\n        }\n      } catch (err) {\n        console.error('[LOGIN] error', err);\n        showMsg('No se pudo conectar con el servidor.');\n      } finally {\n        submitBtn.disabled = false;\n        submitBtn.textContent = 'Iniciar sesión';\n      }\n    });\n\n    // Reenviar verificación (pide email)\n    btnResend.addEventListener('click', async () => {\n      const email = prompt('Ingresa tu correo para reenviar verificación:');\n      if (!email) return;\n      showMsg('Enviando verificación...', 'ok');\n      try {\n        const res = await fetch('/api/verify/resend', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },\n          body: new URLSearchParams({ email })\n        });\n        const data = await res.json().catch(() => ({}));\n        if (res.ok) {\n          // Mensaje único: el servidor ya no dice si la cuenta existe.\n          showMsg(data.message || 'Listo. Revisa tu correo (o carpeta de spam).', 'ok');\n        } else {\n          showMsg('No se pudo reenviar. Intenta más tarde.');\n        }\n      } catch (e) {\n        console.error('[RESEND] error', e);\n        showMsg('No se pudo reenviar. Intenta más tarde.');\n      }\n    });\n  </script>\n  <!-- Google tag (gtag.js) -->\n    <script async=\"\" src=\"https://www.googletagmanager.com/gtag/js?id=G-X63BMSG51V\"></script>\n    <script>\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n\n        gtag('config', 'G-X63BMSG51V');\n    </script>\n<script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092\" integrity=\"sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==\" data-cf-beacon=\"{&quot;version&quot;:&quot;2024.11.0&quot;,&quot;token&quot;:&quot;4acbaa56eb194ce38d8dee48b7d54022&quot;,&quot;r&quot;:1,&quot;spa&quot;:2}\" crossorigin=\"anonymous\"></script>\n\n\n</body>",
 "texto_visible": "Iniciar sesión\n\n¡Ingresa a tu cuenta!\n\nUsuario o correo\nContraseña\n\n¿Olvidaste tu contraseña?\n\nIniciar sesión\no\nContinuar con Google\n\nCredenciales inválidas\n\n¿Todavía no tienes una cuenta? Regístrate\n\n← Volver a la tienda"
}