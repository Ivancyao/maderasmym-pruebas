{
 "url": "https://www.maderasmym.cl/forgot-password",
 "titulo": "Maderas M&M - Recuperar contraseña",
 "form": "<form id=\"forgot-form\" novalidate=\"\">\n        <div class=\"field\">\n          <label for=\"identificador\">Correo o nombre de usuario</label>\n          <input type=\"text\" name=\"identificador\" id=\"identificador\" placeholder=\"tu@correo.com\" required=\"\" autocomplete=\"username\" class=\"invalid\">\n          <div class=\"hint\">El enlace llega al correo con el que te registraste.</div>\n        </div>\n\n        <button type=\"submit\">Enviar enlace</button>\n      </form>",
 "body": "<body>\n  <main>\n    <div class=\"form-container\">\n      <a href=\"/\" class=\"auth-logo-link\" aria-label=\"Volver al inicio\">\n        <img src=\"/assets/mymlog.png\" alt=\"Maderas MyM\" class=\"auth-logo\">\n      </a>\n      <h1>¿Olvidaste tu contraseña?</h1>\n      <p>Te enviaremos un enlace para crear una nueva.</p>\n\n      <form id=\"forgot-form\" novalidate=\"\">\n        <div class=\"field\">\n          <label for=\"identificador\">Correo o nombre de usuario</label>\n          <input type=\"text\" name=\"identificador\" id=\"identificador\" placeholder=\"tu@correo.com\" required=\"\" autocomplete=\"username\" class=\"invalid\">\n          <div class=\"hint\">El enlace llega al correo con el que te registraste.</div>\n        </div>\n\n        <button type=\"submit\">Enviar enlace</button>\n      </form>\n\n      <p id=\"msg\" class=\"error\">Ingresa tu correo o nombre de usuario.</p>\n\n      <p><a href=\"/login\">Volver a iniciar sesión</a></p>\n    </div>\n\n    <p class=\"back-link\"><a href=\"/\">← Volver a la tienda</a></p>\n  </main>\n\n  <script>\n    const form   = document.getElementById('forgot-form');\n    const campo  = document.getElementById('identificador');\n    const msg    = document.getElementById('msg');\n    const submitBtn = form.querySelector('button[type=\"submit\"]');\n\n    function showMsg(text, kind='error') {\n      msg.textContent = text;\n      msg.className = '';\n      msg.classList.add(kind === 'ok' ? 'ok' : 'error');\n    }\n    function hideMsg() {\n      msg.textContent = '';\n      msg.className = 'escondido';\n    }\n\n    // Si venía desde el login con el usuario escrito, lo precargamos.\n    const previo = new URLSearchParams(location.search).get('u');\n    if (previo) campo.value = previo;\n\n    form.addEventListener('submit', async (e) => {\n      e.preventDefault();\n      hideMsg();\n\n      const identificador = campo.value.trim();\n      if (!identificador) {\n        campo.classList.add('invalid');\n        showMsg('Ingresa tu correo o nombre de usuario.');\n        return;\n      }\n      campo.classList.remove('invalid');\n\n      submitBtn.disabled = true;\n      submitBtn.textContent = 'Enviando...';\n\n      try {\n        const res = await fetch('/api/password/forgot', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ identificador })\n        });\n        const data = await res.json().catch(() => ({}));\n\n        if (!res.ok) {\n          showMsg(data.message || 'No se pudo enviar el enlace. Intenta más tarde.');\n          return;\n        }\n\n        showMsg('Si la cuenta existe, te enviamos un enlace. Revisa tu correo (también spam/promociones).', 'ok');\n        form.reset();\n      } catch (err) {\n        console.error('[FORGOT] error', err);\n        showMsg('No se pudo conectar con el servidor.');\n      } finally {\n        submitBtn.disabled = false;\n        submitBtn.textContent = 'Enviar enlace';\n      }\n    });\n  </script>\n  <!-- Google tag (gtag.js) -->\n  <script async=\"\" src=\"https://www.googletagmanager.com/gtag/js?id=G-X63BMSG51V\"></script>\n  <script>\n    window.dataLayer = window.dataLayer || [];\n    function gtag(){dataLayer.push(arguments);}\n    gtag('js', new Date());\n\n    gtag('config', 'G-X63BMSG51V');\n  </script>\n<script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092\" integrity=\"sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==\" data-cf-beacon=\"{&quot;version&quot;:&quot;2024.11.0&quot;,&quot;token&quot;:&quot;4acbaa56eb194ce38d8dee48b7d54022&quot;,&quot;r&quot;:1,&quot;spa&quot;:2}\" crossorigin=\"anonymous\"></script>\n\n\n</body>",
 "texto_visible": "¿Olvidaste tu contraseña?\n\nTe enviaremos un enlace para crear una nueva.\n\nCorreo o nombre de usuario\nEl enlace llega al correo con el que te registraste.\nEnviar enlace\n\nIngresa tu correo o nombre de usuario.\n\nVolver a iniciar sesión\n\n← Volver a la tienda"
}