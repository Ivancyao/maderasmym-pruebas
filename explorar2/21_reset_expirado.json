{
 "url": "https://www.maderasmym.cl/reset-password?token=EXPIRADO123",
 "titulo": "Maderas M&M - Nueva contraseña",
 "body": "<body>\n  <main>\n    <div class=\"form-container\">\n      <a href=\"/\" class=\"auth-logo-link\" aria-label=\"Volver al inicio\">\n        <img src=\"/assets/mymlog.png\" alt=\"Maderas MyM\" class=\"auth-logo\">\n      </a>\n      <h1>Nueva contraseña</h1>\n      <p id=\"subtitulo\">Este enlace no es válido o ya expiró.</p>\n\n      <form id=\"reset-form\" class=\"escondido\" novalidate=\"\">\n        <div class=\"field\">\n          <label for=\"password\">Nueva contraseña</label>\n          <input type=\"password\" name=\"password\" id=\"password\" placeholder=\"Nueva contraseña\" required=\"\" autocomplete=\"new-password\" minlength=\"8\" pattern=\"^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{8,}$\">\n          <div class=\"hint\">Mínimo 8 caracteres, con mayúscula, minúscula y número.</div>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"password2\">Repetir contraseña</label>\n          <input type=\"password\" name=\"password2\" id=\"password2\" placeholder=\"Repite la contraseña\" required=\"\" autocomplete=\"new-password\">\n        </div>\n\n        <button type=\"submit\">Guardar contraseña</button>\n      </form>\n\n      <p id=\"msg\" class=\"error\">Los enlaces duran 60 minutos y solo pueden usarse una vez.</p>\n\n      <p id=\"link-nuevo\" class=\"\"><a href=\"/forgot-password\">Solicitar un enlace nuevo</a></p>\n      <p><a href=\"/login\">Volver a iniciar sesión</a></p>\n    </div>\n\n    <p class=\"back-link\"><a href=\"/\">← Volver a la tienda</a></p>\n  </main>\n\n  <script>\n    const form      = document.getElementById('reset-form');\n    const pass      = document.getElementById('password');\n    const pass2     = document.getElementById('password2');\n    const msg       = document.getElementById('msg');\n    const subtitulo = document.getElementById('subtitulo');\n    const linkNuevo = document.getElementById('link-nuevo');\n    const submitBtn = form.querySelector('button[type=\"submit\"]');\n\n    const passRe = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{8,}$/;\n\n    const params = new URLSearchParams(location.search);\n    const uid    = params.get('uid') || '';\n    const token  = params.get('token') || '';\n\n    function showMsg(text, kind='error') {\n      msg.textContent = text;\n      msg.className = '';\n      msg.classList.add(kind === 'ok' ? 'ok' : 'error');\n    }\n    function hideMsg() {\n      msg.textContent = '';\n      msg.className = 'escondido';\n    }\n    function mostrarFormulario(mostrar) {\n      form.className = mostrar ? '' : 'escondido';\n    }\n    function enlaceInvalido() {\n      subtitulo.textContent = 'Este enlace no es válido o ya expiró.';\n      mostrarFormulario(false);\n      linkNuevo.className = '';\n      showMsg('Los enlaces duran 60 minutos y solo pueden usarse una vez.');\n    }\n\n    // Valida el enlace antes de mostrar el formulario.\n    (async () => {\n      if (!uid || !token) return enlaceInvalido();\n\n      try {\n        const res = await fetch(`/api/password/reset/check?uid=${encodeURIComponent(uid)}&token=${encodeURIComponent(token)}`);\n        const data = await res.json().catch(() => ({}));\n\n        if (data.code === 'SERVER_ERROR') {\n          subtitulo.textContent = 'No se pudo validar el enlace.';\n          showMsg('Hubo un problema en el servidor. Vuelve a intentarlo en unos minutos.');\n          return;\n        }\n        if (!res.ok || !data.ok) return enlaceInvalido();\n\n        subtitulo.textContent = `Define una contraseña nueva para la cuenta ${data.user || ''}.`;\n        mostrarFormulario(true);\n        pass.focus();\n      } catch (err) {\n        console.error('[RESET] error validando', err);\n        subtitulo.textContent = 'No se pudo validar el enlace.';\n        showMsg('No se pudo conectar con el servidor. Intenta recargar la página.');\n      }\n    })();\n\n    pass2.addEventListener('input', () => {\n      if (pass2.value && pass.value && pass2.value !== pass.value) {\n        pass2.classList.add('invalid');\n      } else {\n        pass2.classList.remove('invalid');\n      }\n    });\n\n    form.addEventListener('submit', async (e) => {\n      e.preventDefault();\n      hideMsg();\n      pass.classList.remove('invalid');\n      pass2.classList.remove('invalid');\n\n      if (!passRe.test(pass.value)) {\n        pass.classList.add('invalid');\n        showMsg('La contraseña debe tener mínimo 8 caracteres e incluir mayúscula, minúscula y número.');\n        return;\n      }\n      if (pass.value !== pass2.value) {\n        pass2.classList.add('invalid');\n        showMsg('Las contraseñas no coinciden.');\n        return;\n      }\n\n      submitBtn.disabled = true;\n      submitBtn.textContent = 'Guardando...';\n\n      try {\n        const res = await fetch('/api/password/reset', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ uid, token, password: pass.value })\n        });\n        const data = await res.json().catch(() => ({}));\n\n        if (!res.ok) {\n          if (data.code === 'INVALID_TOKEN') return enlaceInvalido();\n          showMsg(data.message || 'No se pudo cambiar la contraseña.');\n          return;\n        }\n\n        mostrarFormulario(false);\n        subtitulo.textContent = '¡Listo!';\n        showMsg('Tu contraseña fue actualizada. Redirigiendo al inicio de sesión...', 'ok');\n        setTimeout(() => { location.href = data.redirect || '/login'; }, 2000);\n      } catch (err) {\n        console.error('[RESET] error', err);\n        showMsg('No se pudo conectar con el servidor.');\n      } finally {\n        submitBtn.disabled = false;\n        submitBtn.textContent = 'Guardar contraseña';\n      }\n    });\n  </script>\n  <!-- Google tag (gtag.js) -->\n  <script async=\"\" src=\"https://www.googletagmanager.com/gtag/js?id=G-X63BMSG51V\"></script>\n  <script>\n    window.dataLayer = window.dataLayer || [];\n    function gtag(){dataLayer.push(arguments);}\n    gtag('js', new Date());\n\n    gtag('config', 'G-X63BMSG51V');\n  </script>\n<script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092\" integrity=\"sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==\" data-cf-beacon=\"{&quot;version&quot;:&quot;2024.11.0&quot;,&quot;token&quot;:&quot;4acbaa56eb194ce38d8dee48b7d54022&quot;,&quot;r&quot;:1,&quot;spa&quot;:2}\" crossorigin=\"anonymous\"></script>\n\n\n</body>",
 "texto_visible": "Nueva contraseña\n\nEste enlace no es válido o ya expiró.\n\nLos enlaces duran 60 minutos y solo pueden usarse una vez.\n\nSolicitar un enlace nuevo\n\nVolver a iniciar sesión\n\n← Volver a la tienda"
}